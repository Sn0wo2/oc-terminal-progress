{
  "name": "@me0wo/opencode-terminal-progress",
  "version": "0.0.0",
  "type": "module",
  "description": "OpenCode TUI plugin for terminal notifications: system toasts, bell, OSC notify, and progress",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sn0wo2/oc-terminal-progress.git"
  },
  "packageManager": "bun@1.4.4",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "assets"
  ],
  "exports": {
    "./tui": "./src/tui.ts"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "check": "tsc --noEmit",
    "security": "bun audit --registry=https://registry.npmjs.org",
    "ci": "bun run lint && bun run check && bun run security"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@opentui/core": "~0.6.8",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
